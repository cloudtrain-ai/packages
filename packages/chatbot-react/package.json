{
  "name": "@cloudtrain/chatbot-react",
  "version": "0.0.51",
  "description": "CloudTrain Chatbot Web Component React Wrapper",
  "keywords": [
    "CloudTrain"
  ],
  "homepage": "https://cloudtrain.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudtrain-ai/packages"
  },
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/types/components/stencil-generated/components.server.d.ts",
      "import": "./dist/components/stencil-generated/components.server.js",
      "default": "./dist/components/stencil-generated/components.server.js"
    },
    "./package.json": "./package.json"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node ./__tests__/cloudtrain-chatbot-react.test.js",
    "build": "rm -rf dist && npm run tsc",
    "tsc": "tsc -p . --outDir ./dist",
    "publish-package": "npm publish --access public"
  },
  "dependencies": {
    "@cloudtrain/chatbot": "*",
    "@stencil/react-output-target": "~1.6.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
