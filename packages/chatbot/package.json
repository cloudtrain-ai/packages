{
  "name": "@cloudtrain/chatbot",
  "version": "0.0.49",
  "description": "CloudTrain Chatbot Web Component",
  "keywords": [
    "CloudTrain"
  ],
  "homepage": "https://cloudtrain.ai",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/cloudtrain-chatbot/cloudtrain-chatbot.esm.js",
  "exports": {
    ".": {
      "import": "./dist/cloudtrain-chatbot/cloudtrain-chatbot.esm.js",
      "require": "./dist/cloudtrain-chatbot/cloudtrain-chatbot.cjs.js"
    },
    "./dist/*": {
      "import": "./dist/*",
      "types": "./dist/*"
    },
    "./components/*": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    },
    "./hydrate": {
      "types": "./hydrate/index.d.ts",
      "import": "./hydrate/index.js",
      "require": "./hydrate/index.cjs.js",
      "default": "./hydrate/index.js"
    }
  },
  "files": [
    "dist/",
    "loader/",
    "hydrate/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate",
    "publish-package": "npm publish --access public"
  },
  "devDependencies": {
    "@stencil/core": "^4.31.0",
    "@stencil/react-output-target": "^1.0.2",
    "@tailwindcss/postcss": "^4.1.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.17",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "puppeteer": "^24.8.2",
    "stencil-tailwind-plugin": "^2.0.5",
    "tailwindcss": "^4.1.6"
  },
  "license": "MIT",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "marked": "^15.0.11",
    "stencil-click-outside": "^1.8.0",
    "tailwind-merge": "^3.2.0"
  }
}
